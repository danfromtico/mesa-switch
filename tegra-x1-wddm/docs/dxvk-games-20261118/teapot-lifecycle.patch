+bool startJournal() {
+    wchar_t path[1024];
+    DWORD count = GetEnvironmentVariableW(L"SWITCHWOA_EXIT_JOURNAL",path,1024);
+    if (!count || count >= 1024) return false;
+    journal = CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_NEW,
+                          FILE_ATTRIBUTE_NORMAL|FILE_FLAG_WRITE_THROUGH,nullptr);
+    return journal != INVALID_HANDLE_VALUE;
+}
+
+void milestone(const char* label) {
+    if (!journalHealthy || journal == INVALID_HANDLE_VALUE) return;
+    LARGE_INTEGER qpc;
+    FILETIME clock;
+    QueryPerformanceCounter(&qpc);
+    GetSystemTimeAsFileTime(&clock);
+    const uint64_t time = (uint64_t(clock.dwHighDateTime)<<32) | clock.dwLowDateTime;
+    char text[192];
+    const int n = std::snprintf(text,sizeof(text),"%llu,%lld,%lu,%s\r\n",
+                              (unsigned long long)time,qpc.QuadPart,GetCurrentProcessId(),label);
+    DWORD written = 0;
+    journalHealthy = n>0 && (size_t)n<sizeof(text) &&
+                     WriteFile(journal,text,DWORD(n),&written,nullptr) && written==DWORD(n) &&
+                     FlushFileBuffers(journal);
+}
