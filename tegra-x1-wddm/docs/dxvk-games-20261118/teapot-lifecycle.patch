+void checkWindowImage(HWND window) {
+    HDC dc = GetDC(window);
+    HDC memory = CreateCompatibleDC(dc);
+    BITMAPINFO bitmap = {};
+    bitmap.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);
+    bitmap.bmiHeader.biWidth=width; bitmap.bmiHeader.biHeight=-int(height);
+    bitmap.bmiHeader.biPlanes=1; bitmap.bmiHeader.biBitCount=32; bitmap.bmiHeader.biCompression=BI_RGB;
+    void *bits = nullptr;
+    HBITMAP dib=CreateDIBSection(memory,&bitmap,DIB_RGB_COLORS,&bits,nullptr,0);
+    HGDIOBJ old=dib ? SelectObject(memory,dib) : nullptr;
+    BOOL copied=old && old!=HGDI_ERROR && BitBlt(memory,0,0,width,height,dc,0,0,SRCCOPY) && GdiFlush();
+    unsigned matched=0;
+    if (copied) {
+        const uint8_t *color=static_cast<const uint8_t *>(bits);
+        for (unsigned i=0;i<width*height;i++) {
+            const uint8_t *ref=&referenceRgb[3*i];
+            matched+=std::abs(int(ref[0])-color[4*i+2])<=2 &&
+                     std::abs(int(ref[1])-color[4*i+1])<=2 &&
+                     std::abs(int(ref[2])-color[4*i])<=2;
+        }
+    }
+    if (old && old!=HGDI_ERROR) SelectObject(memory,old);
+    if (dib) DeleteObject(dib);
+    if (memory) DeleteDC(memory);
+    if (dc) ReleaseDC(window,dc);
+    std::printf("WINDOW matched=%u total=%u\n",matched,width*height);
+    if (!copied || matched < width*height*99/100) throw std::runtime_error("window differs from rendered teapot");
+}
+uint64_t clockTicks() { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
