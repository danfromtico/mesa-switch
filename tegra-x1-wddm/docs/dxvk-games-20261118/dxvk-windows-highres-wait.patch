+
+      bool wait(int64_t ticks) {
+        if (!m_timer)
+          return false;
+
+        LARGE_INTEGER due;
+        due.QuadPart = -ticks;
+        if (::SetWaitableTimerEx(m_timer, &due, 0, nullptr, nullptr, nullptr, 0)
+         && ::WaitForSingleObject(m_timer, INFINITE) == WAIT_OBJECT_0)
+          return true;
+
+        ::CloseHandle(m_timer);
+        m_timer = nullptr;
+        return false;
+      }
+
+    private:
